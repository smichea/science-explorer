{
  "name": "science-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual, immersive, local-first atlas of mathematics, physics, chemistry and the history of science.",
  "scripts": {
    "dev": "npm run content:compile && vite dev",
    "build": "npm run content:compile && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run content:compile && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:compile": "tsx --tsconfig scripts/tsconfig.json scripts/compile-content.ts",
    "content:validate": "tsx --tsconfig scripts/tsconfig.json scripts/compile-content.ts --check",
    "schemas:export": "tsx --tsconfig scripts/tsconfig.json scripts/export-schemas.ts"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "idb": "^8.0.3",
    "katex": "^0.18.5",
    "marked": "^15.0.12",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.0.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
